# ============================================================
#  TikTok Cleaner Bot — Environment Variables (مثال)
#  انسخ هذا الملف إلى  .env  ثم عبّئ القيم الحقيقية
#  لا ترفع ملف  .env  إلى GitHub أبدًا
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://tiktokbot:tiktokbot_password@localhost:5432/tiktokbot

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- TikTok Adapter ---
# enable the unofficial Playwright automation (cleanup operations)
TIKTOK_AUTOMATION_ENABLED=true
# headless browser mode (true on servers, false for debugging)
TIKTOK_BROWSER_HEADLESS=true
# session persistence: false = in-memory only (recommended), sessions lost on restart
TIKTOK_PERSIST_SESSION=false

# --- Pacing (فواصل زمنية محافظة بين العمليات) ---
PACING_BASE_DELAY_SECONDS=4.0
PACING_JITTER_MIN=1.0
PACING_JITTER_MAX=3.0
PACING_BACKOFF_BASE=2.0
PACING_BACKOFF_MAX_SECONDS=300
PACING_MAX_CONSECUTIVE_FAILURES=5
PACING_PROGRESS_UPDATE_EVERY=5
PACING_PROGRESS_UPDATE_INTERVAL=15

# --- Broadcast ---
BROADCAST_BATCH_SIZE=20
BROADCAST_DELAY_BETWEEN_MESSAGES=0.5
